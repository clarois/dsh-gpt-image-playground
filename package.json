{
  "name": "dsh-gpt-image-playground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GPT Image 2.6 playground for the DSH Web UI: Flare, Sunburst, and Economy text-to-image and image-to-image generation through the kie.ai API.",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "kie",
    "gpt-image",
    "image-generation"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}